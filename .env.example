# Copy this file to `.env` and fill it in. Anything set here overrides config.json.
# .env is gitignored — this is the safest place for the token.

DISCORD_TOKEN=your-bot-token-here

# Token for a SECOND bot application used only by `npm run dev`.
# Two processes running the same token both receive every interaction and both
# act on it — you'd get two threads, two log entries, two of everything. Give the
# dev bot its own application and this problem disappears.
DEV_DISCORD_TOKEN=

# Optional overrides (normally you'd set these in config.json instead)
# GUILD_ID=
# VERIFICATION_CHANNEL_ID=
# LOG_CHANNEL_ID=
# VERIFIED_ROLE_ID=
# UNVERIFIED_ROLE_ID=
# STAFF_ROLE_IDS=111111111111111111,222222222222222222

# Where the SQLite file lives. Defaults to ./data/bot.db
# DATABASE_PATH=./data/bot.db

# debug | info | warn | error
# LOG_LEVEL=info
