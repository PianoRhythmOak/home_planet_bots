{
  "name": "home-planet-bots",
  "version": "1.0.0",
  "private": true,
  "description": "Home Planet Discord bots — shared TypeScript base + feature modules",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.10.0 <24"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "dev:prod-config": "tsx watch src/index.ts",
    "setup:test": "tsx src/scripts/setup-test.ts",
    "build": "tsc",
    "package": "npm run build && node scripts/package-deploy.mjs",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:watch": "node --import tsx --test --test-concurrency=1 --watch test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
